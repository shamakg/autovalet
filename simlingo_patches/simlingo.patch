+                raise FileNotFoundError
+            img = cv2.imread(path, cv2.IMREAD_COLOR)
+            img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
+            if modality_dropout_prob > 0 and random.random() < modality_dropout_prob:
+                img = np.zeros_like(img)
+            loaded.append(img)
+
+        processed = np.transpose(np.asarray(loaded), (0, 3, 1, 2))  # (T, C, H, W)
+        data['topdown'] = processed
+        return data
